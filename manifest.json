{
  "manifest_version": 3,
  "name": "ClipPad",
  "version": "1.0.0",
  "description": "Professional, local-first contextual clipboard with immutable pinning architecture.",
  "permissions": [
    "clipboardRead",
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_icon": "icons/icon.png",
    "default_title": "ClipPad"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open/Close ClipPad Side Panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}